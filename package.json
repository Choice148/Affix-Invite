{
  "name": "authswitch-demo",
  "version": "1.0.0",
  "description": "AuthSwitch Demo - Simulated Authentication Workflow & State Machine for Cloudflare Pages",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
